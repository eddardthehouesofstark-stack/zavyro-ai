APP_NAME=HelpDesk-360
ENVIRONMENT=development
DATABASE_URL=sqlite:///./helpdesk360.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/helpdesk360
JWT_SECRET=helpdesk360-super-secret-jwt-key-for-development-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=30
JWT_REFRESH_EXPIRE_DAYS=7
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
FILE_STORAGE_PATH=./uploads
STORAGE_BACKEND=local
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,application/pdf,text/plain,application/zip
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=memory
RATE_LIMIT_ENABLED=false
